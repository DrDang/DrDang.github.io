{% assign repo_parts = include.repository | split: '/' %}
{% assign repo_owner = repo_parts[0] %}
{% assign repo_name = repo_parts[1] %}

<div class="repo p-2">
  <a href="https://github.com/{{ include.repository }}" rel="external nofollow noopener" target="_blank" style="text-decoration: none;">
    <div class="card h-100" style="border: 1px solid var(--global-divider-color, #e0e0e0); border-radius: 6px; padding: 16px; min-width: 240px; max-width: 340px;">
      <div class="d-flex align-items-center mb-2">
        <svg height="16" width="16" viewBox="0 0 16 16" style="margin-right: 6px; fill: var(--global-text-color, #555); flex-shrink: 0;" aria-hidden="true">
          <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8Z"/>
        </svg>
        <span style="font-size: 0.9rem; font-weight: 600; color: var(--global-theme-color, #0066cc);">{{ repo_owner }}/{{ repo_name }}</span>
      </div>
      {% if include.description %}
        <p style="font-size: 0.8rem; color: var(--global-text-color, #555); margin: 0; line-height: 1.4;">{{ include.description }}</p>
      {% endif %}
    </div>
  </a>
</div>
